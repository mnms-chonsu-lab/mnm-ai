{
  "endpoint": "/ai/guide",
  "request": {
    "additionalProperties": false,
    "properties": {
      "disease": {
        "anyOf": [
          {
            "enum": [
              "FMD",
              "LSD"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Disease"
      },
      "stage": {
        "title": "Stage",
        "type": "string"
      },
      "query": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "농가·접수자 질문. 없으면 단계별 조항 목록",
        "title": "Query"
      }
    },
    "required": [
      "stage"
    ],
    "title": "GuideRequest",
    "type": "object"
  },
  "response": {
    "$defs": {
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "doc": {
            "title": "Doc",
            "type": "string"
          },
          "clause": {
            "title": "Clause",
            "type": "string"
          },
          "revised_at": {
            "format": "date",
            "title": "Revised At",
            "type": "string"
          }
        },
        "required": [
          "doc",
          "clause",
          "revised_at"
        ],
        "title": "Citation",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "rule_ids": {
        "items": {
          "type": "string"
        },
        "title": "Rule Ids",
        "type": "array"
      },
      "texts": {
        "description": "조항 원문 그대로. rule_ids 와 같은 순서",
        "items": {
          "type": "string"
        },
        "title": "Texts",
        "type": "array"
      },
      "citations": {
        "description": "rule_ids 와 같은 순서",
        "items": {
          "$ref": "#/$defs/Citation"
        },
        "title": "Citations",
        "type": "array"
      },
      "fallback": {
        "description": "근거가 없으면 true. 이때는 RAG-NONE 오류로 반환",
        "title": "Fallback",
        "type": "boolean"
      }
    },
    "required": [
      "rule_ids",
      "texts",
      "citations",
      "fallback"
    ],
    "title": "GuideResponse",
    "type": "object"
  },
  "error": {
    "additionalProperties": false,
    "properties": {
      "code": {
        "const": "RAG-NONE",
        "title": "Code",
        "type": "string"
      },
      "message": {
        "title": "Message",
        "type": "string"
      },
      "detail": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Detail"
      }
    },
    "required": [
      "code",
      "message"
    ],
    "title": "GuideErrorResponse",
    "type": "object"
  },
  "kb_rule": {
    "description": "지식베이스 조항 1개 (mnm-data `biosecurity_rule`, 게시된 것만).\n\nDB 컬럼 이름(`biosecurity_rule_id`, `source_doc`, `display_order`)과 질병 코드 대문자(`FMD`, `LSD`)를\n그대로 받는다. 쓰지 않는 컬럼(`part_code`, `embedding` 등)은 무시한다.",
    "properties": {
      "rule_id": {
        "title": "Rule Id",
        "type": "string"
      },
      "kind": {
        "description": "question · photo_guide · action · form_field · summary · clause",
        "title": "Kind",
        "type": "string"
      },
      "disease": {
        "anyOf": [
          {
            "enum": [
              "FMD",
              "LSD"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "질병 공통이면 null. 소문자로 와도 대문자로 바꿔 받음",
        "title": "Disease"
      },
      "stage": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "suspect · after_report · regional. 단계 공통이면 null",
        "title": "Stage"
      },
      "order": {
        "default": 0,
        "description": "같은 묶음 안 순서",
        "title": "Order",
        "type": "integer"
      },
      "text": {
        "description": "조항 원문 그대로 (화면에 이 문구가 나감)",
        "title": "Text",
        "type": "string"
      },
      "doc": {
        "description": "근거 문서명",
        "title": "Doc",
        "type": "string"
      },
      "clause": {
        "description": "조항",
        "title": "Clause",
        "type": "string"
      },
      "revised_at": {
        "description": "개정일",
        "format": "date",
        "title": "Revised At",
        "type": "string"
      },
      "status": {
        "description": "draft · review · published",
        "title": "Status",
        "type": "string"
      },
      "embedding": {
        "anyOf": [
          {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "biosecurity_rule.embedding (vector(1536)). 있으면 다시 계산하지 않음",
        "title": "Embedding"
      }
    },
    "required": [
      "rule_id",
      "kind",
      "text",
      "doc",
      "clause",
      "revised_at",
      "status"
    ],
    "title": "KbRule",
    "type": "object"
  }
}
